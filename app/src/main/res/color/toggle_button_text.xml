<?xml version="1.0" encoding="utf-8"?>
<!-- Selector de color de texto para los botones de periodo con alto contraste -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Botón seleccionado: Texto blanco puro (#FFFFFF) -->
    <item android:color="#FFFFFF" android:state_checked="true" />
    <!-- Botón no seleccionado: Texto turquesa muy oscuro (#004D40) -->
    <item android:color="#004D40" />
</selector>
